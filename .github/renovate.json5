{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':timezone(Europe/Zurich)',
    ':semanticCommits',
  ],
  customManagers: [
    {
      customType: 'regex',
      description: 'Update versions annotated with a renovate comment in Dockerfiles and metadata files',
      managerFilePatterns: ['/(^|/)Dockerfile$/', '/(^|/)metadata\\.yaml$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\n(?:ARG [A-Z_]+=|version: )(?<currentValue>\\S+)',
      ],
    },
  ],
  packageRules: [
    {
      description: 'Group every GitHub Actions update into one PR',
      matchManagers: ['github-actions'],
      groupName: 'github-actions',
    },
    {
      description: 'Group minor and patch tool updates (mise tools and annotated downloads, not base images or runtimes) into one PR',
      matchManagers: ['mise', 'custom.regex'],
      matchDatasources: ['!docker', '!node-version'],
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'tools',
    },
    {
      description: 'Keep dev-desktop on the latest of everything: one grouped PR, automerged once CI passes, with a patch bump so a new tag is published',
      matchFileNames: ['images/dev-desktop/**'],
      groupName: 'dev-desktop',
      automerge: true,
      postUpgradeTasks: {
        commands: ['bash scripts/bump-image-version.sh images/dev-desktop'],
        executionMode: 'branch',
      },
    },
  ],
}
